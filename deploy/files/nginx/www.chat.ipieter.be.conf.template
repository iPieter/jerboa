# /etc/nginx/conf.d/www.chat.ipieter.be.conf, written by deploy/harden_nginx.sh.
# The previous version is in /root/jerboa-state/nginx-backups/<timestamp>/.
# Lines marked "managed by Certbot" are kept exactly as certbot wrote them;
# renewals only reload nginx and do not edit this file.

server {
    server_name chat.ipieter.be www.chat.ipieter.be;
    root /var/www/html;

    access_log /root/chat/logs/nginx_access.log;
    error_log /root/chat/logs/nginx_error.log;

    # Was 256M. Uploads (POST /api/files) above this get "413 Request Entity Too Large".
    client_max_body_size 50m;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate @SSL_CERT@; # managed by Certbot
    ssl_certificate_key @SSL_KEY@; # managed by Certbot
    ssl_dhparam @SSL_DHPARAM@; # managed by Certbot
    # Replaces "include /etc/letsencrypt/options-ssl-nginx.conf", which allowed
    # TLS 1.0/1.1 and 3DES.
    include /etc/nginx/snippets/jerboa-tls.conf;

    include /etc/nginx/snippets/jerboa-security-headers.conf;

    location / {
        try_files $uri $uri/ /index.html?uri=$uri;
    }

    location /emoji/ {
        include /etc/nginx/snippets/jerboa-proxy.conf;
        proxy_pass http://127.0.0.1:9000/emoji/;
    }

    location /api/ {
        include /etc/nginx/snippets/jerboa-proxy.conf;
        proxy_pass http://127.0.0.1:9000/;
    }

    location /socket.io/ {
        include /etc/nginx/snippets/jerboa-proxy.conf;
        proxy_redirect off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_pass http://127.0.0.1:9000;
    }
}

server {
    if ($host = chat.ipieter.be) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80 default_server;
    listen [::]:80 default_server;
    server_name chat.ipieter.be www.chat.ipieter.be;
    return 404; # managed by Certbot
}
